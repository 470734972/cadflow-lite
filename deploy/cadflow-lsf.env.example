# Persistent configuration. The Web configuration page stores LSF runtime values in SQLite.
# Do not add site-specific LSF/FlexNet paths here; configure them from the Web UI.
CADFLOW_MODE=demo
CADFLOW_CLUSTER_NAME=demo-cluster
CADFLOW_DB_PATH=/var/lib/cadflow-lite/cadflow.db
CADFLOW_BIND_HOST=0.0.0.0
CADFLOW_PORT=8080
CADFLOW_ADMIN_TOKEN=replace-with-a-long-random-token
CADFLOW_DB_RETENTION_DAYS=7
CADFLOW_DB_MAX_SIZE_MB=1024
