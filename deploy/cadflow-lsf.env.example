# Copy to /etc/cadflow/cadflow.env. This file is read by the systemd service.
CADFLOW_MODE=lsf
CADFLOW_CLUSTER_NAME=production-lsf
CADFLOW_DB_PATH=/var/lib/cadflow/cadflow.db
CADFLOW_ADMIN_TOKEN=replace-with-a-long-random-token
CADFLOW_COLLECT_INTERVAL_SECONDS=300
CADFLOW_COMMAND_TIMEOUT_SECONDS=45
CADFLOW_STALE_AFTER_SECONDS=660

# Directory holding bjobs, bqueues, bhosts and lsload from the authorised LSF client.
CADFLOW_LSF_BIN_DIR=/opt/lsf/10.1/linux3.10-glibc2.17-x86_64/bin
# lmstat must be an approved FlexNet binary, not an arbitrary script.
CADFLOW_LMSTAT_PATH=/opt/flexnet/bin/lmstat
CADFLOW_LICENSE_SERVERS=27000@license01,27000@license02
CADFLOW_LICENSE_VENDOR=snpslmd

# Source this site-owned file before starting CADFlow so LSF_ENVDIR, PATH and library paths are correct.
CADFLOW_LSF_PROFILE=/etc/profile.d/lsf.sh
