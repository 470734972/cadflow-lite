[Unit]
Description=CADFlow Lite native LSF portal
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=cadflow
Group=cadflow
WorkingDirectory=/opt/cadflow-lite/current
EnvironmentFile=/etc/cadflow-lite/cadflow.env
ExecStart=/opt/cadflow-lite/current/deploy/cadflow-serve
Restart=on-failure
RestartSec=5
TimeoutStartSec=60
TimeoutStopSec=30
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/cadflow-lite

[Install]
WantedBy=multi-user.target
